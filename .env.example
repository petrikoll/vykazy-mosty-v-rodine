PORT=3001
APP_DB_PATH=./data/app-db.json
# Náhodný tajný kód chrání první založení účtu Odborného garanta.
APP_SETUP_TOKEN=

# Gemini vytváří rozdělení hodin, návrhy zápisů a rozpoznává skeny výkazů.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DOCUMENT_MODEL=gemini-2.5-flash

# JSON servisního účtu zakódujte do Base64 a cílový Sheet i kořenovou složku
# nasdílejte e-mailu servisního účtu jako editorovi.
GOOGLE_SERVICE_ACCOUNT_BASE64=
GOOGLE_SHEETS_ID=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Pro osobní Gmail použijte OAuth. Po prvním přihlášení aplikace vytvoří složku sama.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/google-drive/callback
GOOGLE_DRIVE_APP_URL=http://127.0.0.1:5174/
GOOGLE_DRIVE_ALLOWED_EMAIL=
GOOGLE_DRIVE_FOLDER_NAME=Mosty v rodině – podepsané výkazy
GOOGLE_DRIVE_TOKEN_PATH=./data/google-drive-oauth.json

# Bezplatný Render obnovuje databázi ze skrytých JSON sloupců Google Sheetu.
GOOGLE_SHEETS_PRIMARY=false
# Na Renderu uložte refresh token jako tajnou proměnnou; nikdy jej neposílejte do Gitu.
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ACCOUNT_EMAIL=

# Web Push (bezplatná upozornění i při zavřené nainstalované aplikaci).
# Dvojici klíčů vytvoří příkaz: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:emceckovm@gmail.com
